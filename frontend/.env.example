# Frontend environment variables (Create React App)
# Copy to `.env` (managed by orchestrator in this environment) for local development.

# Requested: base URL of the backend API (e.g., https://api.example.com)
REACT_APP_API_BASE=

# Optional fallback already supported by this project
REACT_APP_BACKEND_URL=

# Other container env vars may exist, but these are the ones relevant to API connectivity.
